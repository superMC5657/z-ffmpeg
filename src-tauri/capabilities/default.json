{
  "identifier": "default",
  "description": "Default capability for zffmpeg",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "shell:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "log:default"
  ]
}
